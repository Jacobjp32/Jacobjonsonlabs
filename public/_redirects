# Host-scoped so jacobjonsonlabs.com does not match and cannot loop.
# Netlify reads this file before netlify.toml. There is no /* 200 rewrite:
# prerendered pages are real files, and anything else must 404.
https://jacobjonsonlabs.netlify.app/* https://jacobjonsonlabs.com/:splat 301!

# Legacy aliases
/servicos /services/ 301
/servicos/ /services/ 301
/automacao-ia /services/#automation 301
/automacao-ia/ /services/#automation 301
/ai-automation /en/services/#automation 301
